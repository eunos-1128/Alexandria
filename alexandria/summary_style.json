{
  "origin": "Extracted from Manuscript project create_tags() function",
  "list_indent_step": 28,
  "tags": {
    "h1": {"scale": 2.4, "weight": 800, "pixels_above_lines": 22, "pixels_below_lines": 4,
           "foreground": {"light": "#1c3d8a", "dark": "#c8d7ff"}},
    "h2": {"scale": 1.9, "weight": 800, "pixels_above_lines": 18, "pixels_below_lines": 3,
           "foreground": {"light": "#2456b3", "dark": "#a6c8ff"}},
    "h3": {"scale": 1.5, "weight": 700, "pixels_above_lines": 14, "pixels_below_lines": 2,
           "foreground": {"light": "#3568c5", "dark": "#8fb6ff"}},
    "h4": {"scale": 1.3, "weight": 700, "pixels_above_lines": 12, "pixels_below_lines": 2,
           "foreground": {"light": "#4174c9", "dark": "#7da5ef"}},
    "h5": {"scale": 1.15, "weight": 600, "pixels_above_lines": 10, "pixels_below_lines": 2,
           "foreground": {"light": "#5481cf", "dark": "#6f97e2"}},
    "h6": {"scale": 1.05, "weight": 600, "pixels_above_lines": 8, "pixels_below_lines": 2,
           "foreground": {"light": "#77767b", "dark": "#9a9996"}},

    "bold": {"weight": 700},
    "italic": {"style": "italic"},
    "strikethrough": {"strikethrough": true},
    "inline-code": {"family": "monospace", "scale": 0.88,
                    "foreground": {"light": "#b45309", "dark": "#ffd6a5"},
                    "background": {"light": "#fef3c7", "dark": "#2a2826"}},
    "link": {"underline": "single",
             "foreground": {"light": "#1c71d8", "dark": "#78aeed"}},

    "paragraph": {"pixels_above_lines": 6, "pixels_below_lines": 6, "pixels_inside_wrap": 4},
    "blockquote": {"left_margin": 32, "style": "italic",
                   "pixels_above_lines": 8, "pixels_below_lines": 8, "pixels_inside_wrap": 4,
                   "foreground": {"light": "#3b4a64", "dark": "#c8d4e8"},
                   "paragraph_background": {"light": "#eef3fb", "dark": "#1d2535"}},
    "code-block": {"family": "monospace", "scale": 0.88,
                   "left_margin": 48, "right_margin": 32,
                   "pixels_above_lines": 4, "pixels_below_lines": 4,
                   "foreground": {"light": null, "dark": "#c0caf5"},
                   "paragraph_background": {"light": "#f0f2f5", "dark": "#212135"}},
    "list-item": {"left_margin": 56, "indent": -20,
                  "pixels_above_lines": 4, "pixels_below_lines": 4, "pixels_inside_wrap": 4},
    "table": {"family": "monospace", "scale": 0.85,
              "left_margin": 48, "right_margin": 32,
              "pixels_above_lines": 2, "pixels_below_lines": 2,
              "paragraph_background": {"light": "#f6f8fa", "dark": "#1e1e2e"}},
    "table-header": {"weight": 700},
    "rule": {"pixels_above_lines": 8, "pixels_below_lines": 8,
             "foreground": {"light": "#c0bfbc", "dark": "#5e5c64"}}
  }
}
